# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ImageKit Configuration
# Configurez ces variables dans votre environnement

# Clé publique ImageKit (obtenue depuis le tableau de bord ImageKit)
IMAGEKIT_PUBLIC_KEY=

# Endpoint ImageKit (par défaut: https://ik.imagekit.io/)
IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/

# Variables supplémentaires si nécessaire
# SUPABASE_DATABASE_URL=
# OTHER_ENV_VARS=...

