# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ImageKit (transformation WebP des images distantes, mode fetch)
# Préfixe VITE_ obligatoire : seules ces vars sont exposées au navigateur.
# Aucune clé ici : la transformation par URL n'a besoin que de l'endpoint public.
# NE JAMAIS ajouter de clé privée avec un préfixe VITE_ (elle fuirait dans le bundle).
VITE_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/ccx3pyrrg
# Coupe-circuit (false = originales, secours si endpoint en panne).
# Verifier dans le dashboard ImageKit : ID d'endpoint, compte actif, fetch distant autorise.
VITE_IMAGEKIT_ENABLED=false

# Variables supplémentaires si nécessaire
# SUPABASE_DATABASE_URL=
# OTHER_ENV_VARS=...

